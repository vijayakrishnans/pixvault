// Rendered to wrangler.jsonc by tooling/wire/render.mjs (BF6 deploy-time wiring).
// Resource IDs are NEVER committed: @@wiring(<component>/<env>:<key>)@@ tokens are
// resolved from the workspace's orun secrets at deploy time (wire-live) or from the
// committed wiring.fixture.json for offline dry-runs (wire-fixture).
{
  "name": "pixvault-media-worker",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/index.ts",
  "minify": false,
  "vars": {
    "ENVIRONMENT": "local"
  },
  // One SQLite-backed LibraryIndex per library (design §1.3). Exported from src/index.ts.
  "durable_objects": {
    "bindings": [{ "name": "LIBRARY_INDEX", "class_name": "LibraryIndex" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LibraryIndex"] }],
  "env": {
    "dev": {
      "vars": {
        "ENVIRONMENT": "dev",
        "PUBLIC_SHARING": "on"
      },
      "durable_objects": {
        "bindings": [{ "name": "LIBRARY_INDEX", "class_name": "LibraryIndex" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LibraryIndex"] }]
    },
    "stage": {
      "workers_dev": false,
      // Workers Logs: structured lines from src/log.ts (ids and sizes only).
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": {
        "ENVIRONMENT": "stage",
        "PUBLIC_SHARING": "on",
        "SERVE_BASE": "https://pixvault-serve-worker-stage.vijayakrishnan12994.workers.dev",
        "APP_BASE": "https://pixvault-media-web-stage.vijayakrishnan12994.workers.dev",
        "MODERATION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "TAGS_MODEL": "@cf/microsoft/resnet-50"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "pixvault-stage",
          "database_id": "@@wiring(cloudflare-d1/stage:d1_database_id)@@"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "@@wiring(cloudflare-r2/stage:r2_bucket_name)@@"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "ROUTES_KV",
          "id": "@@wiring(cloudflare-kv-media/stage:media_routes_kv_id)@@"
        }
      ],
      // ProcessFileWorkflow (PV4): Workflows instead of a queue (GAPS G56).
      "workflows": [{ "name": "pixvault-process-file-stage", "binding": "PROCESS_FILE", "class_name": "ProcessFileWorkflow" }],
      "images": { "binding": "IMAGES" },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "LIBRARY_INDEX", "class_name": "LibraryIndex" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LibraryIndex"] }],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "pixvault-membership-worker-stage"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "pixvault-policy-worker-stage"
        },
        // Mention emails (PV6), best effort.
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "pixvault-notifications-worker-stage"
        },
        {
          "binding": "PROJECTS_WORKER",
          "service": "pixvault-projects-worker-stage"
        }
      ]
    },
    "prod": {
      "workers_dev": false,
      // Workers Logs: structured lines from src/log.ts (ids and sizes only).
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      "vars": {
        "ENVIRONMENT": "prod",
        "PUBLIC_SHARING": "off",
        "SERVE_BASE": "https://pixvault-serve-worker-prod.vijayakrishnan12994.workers.dev",
        "APP_BASE": "https://pixvault-media-web-prod.vijayakrishnan12994.workers.dev",
        "MODERATION_MODEL": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "TAGS_MODEL": "@cf/microsoft/resnet-50"
      },
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "pixvault-prod",
          "database_id": "@@wiring(cloudflare-d1/prod:d1_database_id)@@"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "@@wiring(cloudflare-r2/prod:r2_bucket_name)@@"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "ROUTES_KV",
          "id": "@@wiring(cloudflare-kv-media/prod:media_routes_kv_id)@@"
        }
      ],
      // ProcessFileWorkflow (PV4): Workflows instead of a queue (GAPS G56).
      "workflows": [{ "name": "pixvault-process-file-prod", "binding": "PROCESS_FILE", "class_name": "ProcessFileWorkflow" }],
      "images": { "binding": "IMAGES" },
      "ai": { "binding": "AI" },
      "durable_objects": {
        "bindings": [{ "name": "LIBRARY_INDEX", "class_name": "LibraryIndex" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LibraryIndex"] }],
      "services": [
        {
          "binding": "MEMBERSHIP_WORKER",
          "service": "pixvault-membership-worker-prod"
        },
        {
          "binding": "POLICY_WORKER",
          "service": "pixvault-policy-worker-prod"
        },
        // Mention emails (PV6), best effort.
        {
          "binding": "NOTIFICATIONS_WORKER",
          "service": "pixvault-notifications-worker-prod"
        },
        {
          "binding": "PROJECTS_WORKER",
          "service": "pixvault-projects-worker-prod"
        }
      ]
    }
  }
}
